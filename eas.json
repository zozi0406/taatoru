{
  "cli": {
    "version": "21.5.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "node": "22.23.2",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "node": "22.23.2",
      "distribution": "internal",
      "environment": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "node": "22.23.2",
      "distribution": "store",
      "environment": "production",
      "autoIncrement": false,
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote"
      }
    },
    "release-apk": {
      "extends": "production",
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "credentialsSource": "remote"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
